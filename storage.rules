rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /slips/{uid}/{fileName} {
      // Students can only write into their own folder, images only, max 5MB.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // A student can read their own slip; anyone signed-in can read (needed because
      // the admin dashboard displays slip thumbnails). If you want to restrict slip
      // reads to admins only, swap the line below for a Firestore cross-check
      // (see README "Tightening storage rules" section) — it requires the
      // Firebase Storage "Rules 2" cross-service get() feature.
      allow read: if request.auth != null;
    }
  }
}
